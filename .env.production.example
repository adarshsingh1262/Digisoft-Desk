# ---------------------------------------------------------------------------
# Production settings for docker-compose.prod.yml. On the server:
#   cp .env.production.example .env   then replace every CHANGE_ME.
# Generate secrets with the command shown next to each one. Never commit .env.
# ---------------------------------------------------------------------------
NODE_ENV=production
LOG_LEVEL=info

# Your two subdomains; both DNS A records must point at the server's Elastic IP.
APP_DOMAIN=app.CHANGE_ME.com
API_DOMAIN=api.CHANGE_ME.com
FRONTEND_URL=https://app.CHANGE_ME.com
BACKEND_URL=https://api.CHANGE_ME.com
PORT=4000
API_PREFIX=api/v1

# Letters and digits only (it is embedded in the database URL): openssl rand -hex 24
POSTGRES_PASSWORD=CHANGE_ME

# openssl rand -base64 48   (two different values)
JWT_SECRET=CHANGE_ME
JWT_REFRESH_SECRET=CHANGE_ME
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN_DAYS=30
COOKIE_SECURE=true

# openssl rand -base64 32   (never change it after channels are configured)
CHANNEL_ENCRYPTION_KEY=CHANGE_ME

# Email through Amazon SES; credentials come from the EC2 instance's IAM role.
EMAIL_PROVIDER=ses
AWS_REGION=ap-south-1
EMAIL_FROM="Digisoft360 Help Desk <support@CHANGE_ME.com>"

# Attachments on a Docker volume shared by the api and worker.
STORAGE_PROVIDER=local
ATTACHMENT_MAX_BYTES=26214400

THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=300
AUTH_THROTTLE_LIMIT=10
WORKER_CONCURRENCY=5
WEBHOOK_MAX_ATTEMPTS=5

# First admin account, created by: ./deploy/deploy.sh --seed
SEED_ADMIN_EMAIL=admin@CHANGE_ME.com
SEED_ADMIN_PASSWORD=CHANGE_ME
