# ---------------------------------------------------------------------------
# Digisoft360 Help Desk — copy to .env and fill in. Never commit real secrets.
# ---------------------------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=debug

# --- URLs -------------------------------------------------------------------
PORT=4000
API_PREFIX=api/v1
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:4000

# --- Datastores -------------------------------------------------------------
# Point this at your managed PostgreSQL instance to skip the local db container.
DATABASE_URL=postgresql://digisoft:digisoft@localhost:5432/digisoft_helpdesk?schema=public
REDIS_URL=redis://localhost:6379

# --- Authentication ---------------------------------------------------------
# Generate with: openssl rand -base64 48
JWT_SECRET=replace-me-with-at-least-32-characters-of-random-data
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace-me-with-another-32-character-random-string
JWT_REFRESH_EXPIRES_IN_DAYS=30
COOKIE_SECURE=false
# COOKIE_DOMAIN=.digisoft360.com

# --- Rate limiting ----------------------------------------------------------
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=120
AUTH_THROTTLE_LIMIT=10

# --- Email ------------------------------------------------------------------
# console (logs the message) | smtp | ses
EMAIL_PROVIDER=smtp
EMAIL_FROM="Digisoft360 Help Desk <no-reply@digisoft360.local>"
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=
# AWS_REGION=ap-south-1

# --- Object storage (used from Phase 2 for attachments) ---------------------
STORAGE_PROVIDER=none
# S3_ENDPOINT=http://localhost:9000
# S3_REGION=us-east-1
# S3_BUCKET=digisoft-helpdesk
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_FORCE_PATH_STYLE=true

# --- Worker -----------------------------------------------------------------
WORKER_CONCURRENCY=5

# --- Frontend (apps/web) ----------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_SOCKET_URL=http://localhost:4000

# --- Seed -------------------------------------------------------------------
SEED_ADMIN_EMAIL=admin@digisoft360.local
SEED_ADMIN_PASSWORD=ChangeMe123!
