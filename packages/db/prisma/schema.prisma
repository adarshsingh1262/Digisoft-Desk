// Digisoft360 Help Desk — Phase 1 (Foundation) schema.
// Every tenant-owned model carries `organizationId`; isolation is enforced by the
// Prisma client extension in src/prisma/tenant.extension.ts, not by callers.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserType {
  AGENT
  CUSTOMER
}

enum ContactStatus {
  ACTIVE
  INACTIVE
  BLOCKED
}

enum TokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
  INVITE
}

enum ActorType {
  USER
  SYSTEM
  AUTOMATION
}

model Organization {
  id             String    @id @default(cuid())
  name           String
  slug           String    @unique
  logoUrl        String?
  domain         String?
  timezone       String    @default("UTC")
  locale         String    @default("en")
  currency       String    @default("USD")
  settings       Json      @default("{}")
  /// Monotonic per-organization ticket counter, bumped inside the creation transaction.
  ticketSequence Int       @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  users               User[]
  roles               Role[]
  departments         Department[]
  teams               Team[]
  contacts            Contact[]
  accounts            Account[]
  businessHours       BusinessHours[]
  holidays            Holiday[]
  auditLogs           AuditLog[]
  refreshTokens       RefreshToken[]
  notifications       Notification[]
  ticketStatuses      TicketStatus[]
  ticketPriorities    TicketPriority[]
  ticketCategories    TicketCategory[]
  tags                Tag[]
  tickets             Ticket[]
  ticketMessages      TicketMessage[]
  attachments         Attachment[]
  ticketLinks         TicketLink[]
  activities          Activity[]
  assignmentRules     AssignmentRule[]
  automationRules     AutomationRule[]
  automationRuns      AutomationRun[]
  slaPolicies         SlaPolicy[]
  blueprints          Blueprint[]
  helpCenter          HelpCenter?
  kbCategories        KbCategory[]
  kbArticles          KbArticle[]
  kbArticleFeedback   KbArticleFeedback[]
  webForms            WebForm[]
  communityCategories CommunityCategory[]
  communityTopics     CommunityTopic[]
  communityReplies    CommunityReply[]
  communityVotes      CommunityVote[]
  channels            Channel[]
  channelIdentities   ChannelIdentity[]
  channelEvents       ChannelEvent[]
  chatSessions        ChatSession[]
  webhookEndpoints    WebhookEndpoint[]
  webhookDeliveries   WebhookDelivery[]
  apiKeys             ApiKey[]
  aiSettings          AiSettings?
  aiInsights          AiInsight[]
  csatSettings        CsatSettings?
  csatResponses       CsatResponse[]
  reportDefinitions   ReportDefinition[]
  reportExports       ReportExport[]
  ticketDailyMetrics  TicketDailyMetric[]
  agentDailyMetrics   AgentDailyMetric[]

  @@index([deletedAt])
  @@map("organizations")
}

model BusinessHours {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  timezone       String   @default("UTC")
  isDefault      Boolean  @default(false)
  /// [{ "day": 1, "start": "09:00", "end": "18:00" }]
  weeklySchedule Json
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  holidays     Holiday[]
  slaPolicies  SlaPolicy[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("business_hours")
}

model Holiday {
  id              String   @id @default(cuid())
  organizationId  String
  businessHoursId String
  name            String
  date            DateTime @db.Date
  createdAt       DateTime @default(now())

  organization  Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  businessHours BusinessHours @relation(fields: [businessHoursId], references: [id], onDelete: Cascade)

  @@unique([businessHoursId, date])
  @@index([organizationId, date])
  @@map("holidays")
}

model User {
  id              String    @id @default(cuid())
  organizationId  String
  email           String
  passwordHash    String?
  firstName       String
  lastName        String
  avatarUrl       String?
  phone           String?
  type            UserType  @default(AGENT)
  contactId       String?   @unique
  isActive        Boolean   @default(true)
  emailVerifiedAt DateTime?
  lastLoginAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  organization       Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contact            Contact?            @relation(fields: [contactId], references: [id], onDelete: SetNull)
  roles              UserRole[]
  departments        UserDepartment[]
  teams              TeamMember[]
  refreshTokens      RefreshToken[]
  tokens             VerificationToken[]
  notifications      Notification[]
  assignedTickets    Ticket[]            @relation("AssignedTickets")
  createdTickets     Ticket[]            @relation("CreatedTickets")
  ticketMessages     TicketMessage[]
  uploads            Attachment[]
  following          TicketFollower[]
  assignedActivities Activity[]          @relation("AssignedActivities")
  createdActivities  Activity[]          @relation("CreatedActivities")
  assignmentRules    AssignmentRule[]
  articles           KbArticle[]         @relation("AuthoredArticles")
  articleFeedback    KbArticleFeedback[]
  topics             CommunityTopic[]    @relation("AuthoredTopics")
  topicReplies       CommunityReply[]    @relation("AuthoredReplies")
  communityVotes     CommunityVote[]
  apiKeys            ApiKey[]            @relation("ApiKeyIdentity")
  createdApiKeys     ApiKey[]            @relation("ApiKeyCreator")
  aiInsights         AiInsight[]
  csatResponses      CsatResponse[]
  reportDefinitions  ReportDefinition[]
  reportExports      ReportExport[]
  dailyMetrics       AgentDailyMetric[]

  @@unique([organizationId, email])
  @@index([organizationId, isActive, deletedAt])
  @@index([organizationId, type])
  @@map("users")
}

model Role {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  systemKey      String?
  description    String?
  isSystem       Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  permissions  RolePermission[]
  users        UserRole[]
  apiKeys      ApiKey[]

  @@unique([organizationId, name])
  @@unique([organizationId, systemKey])
  @@index([organizationId])
  @@map("roles")
}

/// Global catalogue — intentionally NOT tenant scoped.
model Permission {
  id          String  @id @default(cuid())
  key         String  @unique
  resource    String
  action      String
  description String?

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model UserRole {
  userId String
  roleId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

model Department {
  id             String    @id @default(cuid())
  organizationId String
  name           String
  description    String?
  email          String?
  isDefault      Boolean   @default(false)
  parentId       String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  parent          Department?      @relation("DepartmentHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children        Department[]     @relation("DepartmentHierarchy")
  members         UserDepartment[]
  teams           Team[]
  tickets         Ticket[]
  assignmentRules AssignmentRule[]
  webForms        WebForm[]
  channels        Channel[]
  csatResponses   CsatResponse[]
  dailyMetrics    TicketDailyMetric[]

  @@unique([organizationId, name])
  @@index([organizationId, deletedAt])
  @@map("departments")
}

model UserDepartment {
  userId       String
  departmentId String

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  department Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  @@id([userId, departmentId])
  @@index([departmentId])
  @@map("user_departments")
}

model Team {
  id             String    @id @default(cuid())
  organizationId String
  departmentId   String?
  name           String
  description    String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  department      Department?      @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  members         TeamMember[]
  assignmentRules AssignmentRule[]

  @@unique([organizationId, name])
  @@index([organizationId, departmentId])
  @@map("teams")
}

model TeamMember {
  teamId String
  userId String

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([teamId, userId])
  @@index([userId])
  @@map("team_members")
}

model Account {
  id             String    @id @default(cuid())
  organizationId String
  name           String
  website        String?
  industry       String?
  phone          String?
  email          String?
  addressLine1   String?
  addressLine2   String?
  city           String?
  state          String?
  postalCode     String?
  country        String?
  description    String?
  customFields   Json?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contacts     Contact[]
  tickets      Ticket[]
  activities   Activity[]

  @@index([organizationId, name])
  @@index([organizationId, deletedAt])
  @@map("accounts")
}

model Contact {
  id             String        @id @default(cuid())
  organizationId String
  accountId      String?
  firstName      String
  lastName       String?
  email          String?
  phone          String?
  mobile         String?
  jobTitle       String?
  avatarUrl      String?
  status         ContactStatus @default(ACTIVE)
  isVip          Boolean       @default(false)
  customFields   Json?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  deletedAt      DateTime?

  organization      Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  account           Account?          @relation(fields: [accountId], references: [id], onDelete: SetNull)
  portalUser        User?
  channelIdentities ChannelIdentity[]
  chatSessions      ChatSession[]
  tickets           Ticket[]
  messages          TicketMessage[]
  activities        Activity[]
  csatResponses     CsatResponse[]

  @@unique([organizationId, email])
  @@index([organizationId, accountId])
  @@index([organizationId, deletedAt])
  @@index([organizationId, lastName, firstName])
  @@map("contacts")
}

model RefreshToken {
  id             String    @id @default(cuid())
  organizationId String
  userId         String
  tokenHash      String    @unique
  familyId       String
  userAgent      String?
  ip             String?
  expiresAt      DateTime
  revokedAt      DateTime?
  createdAt      DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, familyId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model VerificationToken {
  id        String    @id @default(cuid())
  userId    String
  type      TokenType
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@map("verification_tokens")
}

model Notification {
  id             String    @id @default(cuid())
  organizationId String
  userId         String
  type           String
  title          String
  body           String?
  link           String?
  data           Json?
  readAt         DateTime?
  createdAt      DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([organizationId, userId, readAt, createdAt])
  @@map("notifications")
}

model AuditLog {
  id             String    @id @default(cuid())
  organizationId String
  actorId        String?
  actorType      ActorType @default(USER)
  action         String
  entity         String
  entityId       String
  oldValue       Json?
  newValue       Json?
  ip             String?
  createdAt      DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, entity, entityId, createdAt])
  @@index([organizationId, createdAt])
  @@map("audit_logs")
}

// ---------------------------------------------------------------------------
// Phase 2 — Core helpdesk
// ---------------------------------------------------------------------------

enum TicketSource {
  AGENT
  PORTAL
  WEB_FORM
  EMAIL
  CHAT
  PHONE
  API
  WHATSAPP
  INSTAGRAM
  FACEBOOK
  TELEGRAM
}

enum MessageType {
  /// Visible to the customer.
  PUBLIC_REPLY
  /// Agents only. Never serialised to a customer-facing response.
  INTERNAL_COMMENT
  /// Written by the system, e.g. a merge notice.
  SYSTEM_NOTE
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum TicketLinkType {
  RELATED
  DUPLICATE
  BLOCKS
}

/// Status values are rows, not an enum: organizations may add their own, and no code
/// branches on the name — behaviour comes from the flags.
model TicketStatus {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  systemKey      String?
  color          String   @default("#64748b")
  position       Int      @default(0)
  isDefault      Boolean  @default(false)
  /// Stops the SLA resolution clock and counts as solved in reporting.
  isResolved     Boolean  @default(false)
  /// Terminal: the ticket is archived from active queues.
  isClosed       Boolean  @default(false)
  /// Stops the SLA clock while the ticket waits on someone else (on hold, pending).
  pausesSla      Boolean  @default(false)
  isSystem       Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization    Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  tickets         Ticket[]
  transitionsFrom BlueprintTransition[] @relation("TransitionFrom")
  transitionsTo   BlueprintTransition[] @relation("TransitionTo")

  @@unique([organizationId, name])
  @@unique([organizationId, systemKey])
  @@index([organizationId, position])
  @@map("ticket_statuses")
}

model TicketPriority {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  systemKey      String?
  color          String   @default("#64748b")
  /// Higher wins when automation or assignment rules compare two priorities.
  weight         Int      @default(0)
  position       Int      @default(0)
  isDefault      Boolean  @default(false)
  isSystem       Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  tickets      Ticket[]
  slaTargets   SlaTarget[]
  webForms     WebForm[]
  channels     Channel[]

  @@unique([organizationId, name])
  @@unique([organizationId, systemKey])
  @@index([organizationId, position])
  @@map("ticket_priorities")
}

model TicketCategory {
  id             String    @id @default(cuid())
  organizationId String
  name           String
  description    String?
  parentId       String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  parent       TicketCategory?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children     TicketCategory[] @relation("CategoryHierarchy")
  tickets      Ticket[]
  webForms     WebForm[]
  channels     Channel[]

  @@unique([organizationId, name])
  @@index([organizationId, deletedAt])
  @@map("ticket_categories")
}

model Tag {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  color          String   @default("#64748b")
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  tickets      TicketTag[]

  @@unique([organizationId, name])
  @@map("tags")
}

model Ticket {
  id                        String       @id @default(cuid())
  organizationId            String
  /// Sequential per organization, allocated inside the creation transaction.
  ticketNumber              Int
  subject                   String
  description               String
  source                    TicketSource @default(AGENT)
  /// The configured channel this ticket arrived on; replies go back out the same way.
  channelId                 String?
  contactId                 String?
  accountId                 String?
  departmentId              String?
  assignedAgentId           String?
  categoryId                String?
  statusId                  String
  priorityId                String
  createdById               String?
  /// Mirrors resolutionDueAt so queue sorting needs one column.
  dueAt                     DateTime?
  slaPolicyId               String?
  firstResponseDueAt        DateTime?
  resolutionDueAt           DateTime?
  firstResponseWarnedAt     DateTime?
  resolutionWarnedAt        DateTime?
  firstResponseBreachedAt   DateTime?
  resolutionBreachedAt      DateTime?
  /// Set while the ticket sits in a status that pauses the SLA clock.
  slaPausedAt               DateTime?
  /// Business minutes still available when the clock was paused.
  firstResponseRemainingMin Int?
  resolutionRemainingMin    Int?
  firstResponseAt           DateTime?
  resolvedAt                DateTime?
  closedAt                  DateTime?
  resolutionNote            String?
  mergedIntoTicketId        String?
  customFields              Json?
  createdAt                 DateTime     @default(now())
  updatedAt                 DateTime     @updatedAt
  deletedAt                 DateTime?

  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contact         Contact?         @relation(fields: [contactId], references: [id], onDelete: SetNull)
  account         Account?         @relation(fields: [accountId], references: [id], onDelete: SetNull)
  department      Department?      @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  assignedAgent   User?            @relation("AssignedTickets", fields: [assignedAgentId], references: [id], onDelete: SetNull)
  createdBy       User?            @relation("CreatedTickets", fields: [createdById], references: [id], onDelete: SetNull)
  category        TicketCategory?  @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  status          TicketStatus     @relation(fields: [statusId], references: [id])
  priority        TicketPriority   @relation(fields: [priorityId], references: [id])
  mergedInto      Ticket?          @relation("TicketMerges", fields: [mergedIntoTicketId], references: [id], onDelete: SetNull)
  mergedTickets   Ticket[]         @relation("TicketMerges")
  slaPolicy       SlaPolicy?       @relation(fields: [slaPolicyId], references: [id], onDelete: SetNull)
  activities      Activity[]
  automationRuns  AutomationRun[]
  communityTopics CommunityTopic[]
  chatSessions    ChatSession[]
  aiInsights      AiInsight[]
  csatResponse    CsatResponse?

  messages    TicketMessage[]
  attachments Attachment[]
  tags        TicketTag[]
  followers   TicketFollower[]
  links       TicketLink[]     @relation("TicketLinkSource")
  linkedFrom  TicketLink[]     @relation("TicketLinkTarget")
  channel     Channel?         @relation(fields: [channelId], references: [id])

  @@unique([organizationId, ticketNumber])
  @@index([organizationId, statusId, createdAt])
  @@index([organizationId, priorityId])
  @@index([organizationId, assignedAgentId, statusId])
  @@index([organizationId, departmentId, statusId])
  @@index([organizationId, contactId])
  @@index([organizationId, accountId])
  @@index([organizationId, createdAt])
  @@index([organizationId, dueAt])
  @@index([organizationId, firstResponseDueAt])
  @@index([organizationId, resolutionDueAt])
  @@index([organizationId, deletedAt])
  @@map("tickets")
}

model TicketTag {
  ticketId String
  tagId    String

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([ticketId, tagId])
  @@index([tagId])
  @@map("ticket_tags")
}

/// One row per reply or comment. A conversation is never a single text column.
model TicketMessage {
  id                String           @id @default(cuid())
  organizationId    String
  ticketId          String
  type              MessageType      @default(PUBLIC_REPLY)
  direction         MessageDirection @default(OUTBOUND)
  /// Exactly one author is set: an agent, a contact, or neither for system notes.
  authorUserId      String?
  authorContactId   String?
  bodyText          String
  bodyHtml          String?
  channel           TicketSource     @default(AGENT)
  /// Provider message id, used for email threading from Phase 5.
  externalMessageId String?
  inReplyToId       String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  deletedAt         DateTime?

  organization  Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  ticket        Ticket          @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorUser    User?           @relation(fields: [authorUserId], references: [id], onDelete: SetNull)
  authorContact Contact?        @relation(fields: [authorContactId], references: [id], onDelete: SetNull)
  inReplyTo     TicketMessage?  @relation("MessageThread", fields: [inReplyToId], references: [id], onDelete: SetNull)
  replies       TicketMessage[] @relation("MessageThread")
  attachments   Attachment[]

  @@unique([organizationId, externalMessageId])
  @@index([organizationId, ticketId, createdAt])
  @@index([organizationId, type])
  @@map("ticket_messages")
}

/// Only metadata lives in PostgreSQL; bytes go to object storage.
model Attachment {
  id             String   @id @default(cuid())
  organizationId String
  ticketId       String?
  messageId      String?
  fileName       String
  fileSize       Int
  mimeType       String
  storageKey     String   @unique
  uploadedById   String?
  createdAt      DateTime @default(now())

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  ticket       Ticket?        @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  message      TicketMessage? @relation(fields: [messageId], references: [id], onDelete: Cascade)
  uploadedBy   User?          @relation(fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([organizationId, ticketId])
  @@index([organizationId, messageId])
  @@map("attachments")
}

model TicketFollower {
  ticketId  String
  userId    String
  createdAt DateTime @default(now())

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([ticketId, userId])
  @@index([userId])
  @@map("ticket_followers")
}

model TicketLink {
  id             String         @id @default(cuid())
  organizationId String
  ticketId       String
  linkedTicketId String
  type           TicketLinkType @default(RELATED)
  createdAt      DateTime       @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  ticket       Ticket       @relation("TicketLinkSource", fields: [ticketId], references: [id], onDelete: Cascade)
  linkedTicket Ticket       @relation("TicketLinkTarget", fields: [linkedTicketId], references: [id], onDelete: Cascade)

  @@unique([ticketId, linkedTicketId])
  @@index([organizationId, linkedTicketId])
  @@map("ticket_links")
}

// ---------------------------------------------------------------------------
// Phase 3 — Support operations
// ---------------------------------------------------------------------------

enum ActivityType {
  TASK
  CALL
  EVENT
}

enum ActivityStatus {
  OPEN
  COMPLETED
  CANCELLED
}

enum CallDirection {
  INBOUND
  OUTBOUND
}

enum AssignmentStrategy {
  /// Always the configured agent.
  SPECIFIC_AGENT
  /// Route to a department only; an agent picks it up.
  DEPARTMENT
  /// Rotate through the department's (or team's) active agents.
  ROUND_ROBIN
  /// The active agent with the fewest open tickets.
  LEAST_LOADED
}

enum AutomationTrigger {
  TICKET_CREATED
  TICKET_UPDATED
  TICKET_ASSIGNED
  STATUS_CHANGED
  PRIORITY_CHANGED
  CUSTOMER_REPLIED
  AGENT_REPLIED
  SLA_WARNING
  SLA_BREACHED
}

/// Tasks, calls and events — only where they relate to support work.
model Activity {
  id                  String         @id @default(cuid())
  organizationId      String
  type                ActivityType
  status              ActivityStatus @default(OPEN)
  subject             String
  description         String?
  dueAt               DateTime?
  startAt             DateTime?
  endAt               DateTime?
  completedAt         DateTime?
  callDirection       CallDirection?
  callDurationSeconds Int?
  callOutcome         String?
  /// Provider's call id and recording, set by a telephony channel.
  externalCallId      String?
  recordingUrl        String?
  location            String?
  ticketId            String?
  contactId           String?
  accountId           String?
  assignedToId        String?
  createdById         String?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  deletedAt           DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  ticket       Ticket?      @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  contact      Contact?     @relation(fields: [contactId], references: [id], onDelete: SetNull)
  account      Account?     @relation(fields: [accountId], references: [id], onDelete: SetNull)
  assignedTo   User?        @relation("AssignedActivities", fields: [assignedToId], references: [id], onDelete: SetNull)
  createdBy    User?        @relation("CreatedActivities", fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([organizationId, externalCallId])
  @@index([organizationId, type, status, dueAt])
  @@index([organizationId, ticketId])
  @@index([organizationId, contactId])
  @@index([organizationId, accountId])
  @@index([organizationId, assignedToId, status])
  @@index([organizationId, deletedAt])
  @@map("activities")
}

/// Ordered routing rules evaluated when a ticket is created; the first match wins.
model AssignmentRule {
  id                 String             @id @default(cuid())
  organizationId     String
  name               String
  isActive           Boolean            @default(true)
  position           Int                @default(0)
  /// Condition tree in the shared rule DSL.
  conditions         Json
  strategy           AssignmentStrategy
  departmentId       String?
  teamId             String?
  agentId            String?
  /// Round-robin cursor: the agent who received the previous ticket.
  lastAssignedUserId String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  department   Department?  @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  team         Team?        @relation(fields: [teamId], references: [id], onDelete: SetNull)
  agent        User?        @relation(fields: [agentId], references: [id], onDelete: SetNull)

  @@index([organizationId, isActive, position])
  @@map("assignment_rules")
}

/// Trigger + conditions + actions. Escalations are rules on the SLA triggers.
model AutomationRule {
  id             String            @id @default(cuid())
  organizationId String
  name           String
  description    String?
  isActive       Boolean           @default(true)
  position       Int               @default(0)
  trigger        AutomationTrigger
  conditions     Json
  actions        Json
  runCount       Int               @default(0)
  lastRunAt      DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  runs         AutomationRun[]

  @@index([organizationId, trigger, isActive, position])
  @@map("automation_rules")
}

/// One row per rule evaluation, so an administrator can see why a rule did or did not fire.
model AutomationRun {
  id             String            @id @default(cuid())
  organizationId String
  ruleId         String
  ticketId       String?
  trigger        AutomationTrigger
  matched        Boolean
  actionsApplied Json?
  error          String?
  createdAt      DateTime          @default(now())

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  rule         AutomationRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  ticket       Ticket?        @relation(fields: [ticketId], references: [id], onDelete: SetNull)

  @@index([organizationId, ruleId, createdAt])
  @@index([organizationId, ticketId, createdAt])
  @@map("automation_runs")
}

model SlaPolicy {
  id                   String   @id @default(cuid())
  organizationId       String
  name                 String
  description          String?
  isActive             Boolean  @default(true)
  isDefault            Boolean  @default(false)
  position             Int      @default(0)
  /// Which tickets the policy applies to; the first matching active policy wins.
  conditions           Json
  businessHoursId      String?
  /// Fire the SLA_WARNING trigger this many minutes before a target is due.
  warningMinutesBefore Int      @default(30)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  organization  Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  businessHours BusinessHours? @relation(fields: [businessHoursId], references: [id], onDelete: SetNull)
  targets       SlaTarget[]
  tickets       Ticket[]

  @@unique([organizationId, name])
  @@index([organizationId, isActive, position])
  @@map("sla_policies")
}

/// Per-priority targets. A row with no priority is the fallback for the policy.
model SlaTarget {
  id                   String  @id @default(cuid())
  slaPolicyId          String
  priorityId           String?
  firstResponseMinutes Int
  resolutionMinutes    Int
  /// Count only business hours (from the policy's calendar) or the wall clock.
  useBusinessHours     Boolean @default(true)

  policy   SlaPolicy       @relation(fields: [slaPolicyId], references: [id], onDelete: Cascade)
  priority TicketPriority? @relation(fields: [priorityId], references: [id], onDelete: Cascade)

  @@unique([slaPolicyId, priorityId])
  @@map("sla_targets")
}

/// A configurable state machine applied to matching tickets.
model Blueprint {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  description    String?
  isActive       Boolean  @default(true)
  position       Int      @default(0)
  /// Which tickets the blueprint governs; the first matching active blueprint wins.
  conditions     Json
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  transitions  BlueprintTransition[]

  @@unique([organizationId, name])
  @@index([organizationId, isActive, position])
  @@map("blueprints")
}

model BlueprintTransition {
  id             String   @id @default(cuid())
  blueprintId    String
  name           String
  /// Null means the transition is allowed from any status.
  fromStatusId   String?
  toStatusId     String
  /// Ticket fields that must be set before the transition is allowed.
  requiredFields Json     @default("[]")
  /// Role ids permitted to make the transition; empty means anyone with ticket.update.
  allowedRoleIds Json     @default("[]")
  conditions     Json     @default("{}")
  /// Actions applied after a successful transition.
  actions        Json     @default("[]")
  position       Int      @default(0)
  createdAt      DateTime @default(now())

  blueprint  Blueprint     @relation(fields: [blueprintId], references: [id], onDelete: Cascade)
  fromStatus TicketStatus? @relation("TransitionFrom", fields: [fromStatusId], references: [id], onDelete: Cascade)
  toStatus   TicketStatus  @relation("TransitionTo", fields: [toStatusId], references: [id], onDelete: Cascade)

  @@index([blueprintId, fromStatusId])
  @@map("blueprint_transitions")
}

// ---------------------------------------------------------------------------
// Phase 4 — self-service: help center, knowledge base, web forms, community.
// ---------------------------------------------------------------------------

enum ArticleStatus {
  DRAFT
  PENDING_REVIEW
  PUBLISHED
  ARCHIVED
}

/// Who may read a piece of self-service content. Enforced in the portal query layer,
/// never by hiding links in the UI.
enum ContentVisibility {
  /// Anyone who can reach the help center, signed in or not.
  PUBLIC
  /// Signed-in portal users only.
  PORTAL_USERS
  /// Agents only; never served by a portal route.
  AGENTS_ONLY
}

enum TopicType {
  QUESTION
  DISCUSSION
  IDEA
  PROBLEM
  ANNOUNCEMENT
}

enum TopicStatus {
  OPEN
  ANSWERED
  CLOSED
}

enum ModerationStatus {
  PENDING
  PUBLISHED
  REJECTED
}

/// One customer-facing site per organization: its address, branding and the switches
/// that decide which self-service areas exist at all.
model HelpCenter {
  id                    String   @id @default(cuid())
  organizationId        String   @unique
  /// Portal address segment, unique across the platform.
  slug                  String   @unique
  name                  String
  tagline               String?
  welcomeMessage        String?
  logoUrl               String?
  primaryColor          String   @default("#2563eb")
  supportEmail          String?
  footerText            String?
  isPublished           Boolean  @default(true)
  /// Anonymous visitors may read PUBLIC content. Off makes the whole portal private.
  allowPublicBrowsing   Boolean  @default(true)
  allowSelfRegistration Boolean  @default(true)
  allowTicketSubmission Boolean  @default(true)
  kbEnabled             Boolean  @default(true)
  communityEnabled      Boolean  @default(true)
  /// New topics and replies wait for an agent before they appear publicly.
  moderateCommunity     Boolean  @default(false)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("help_centers")
}

model KbCategory {
  id             String            @id @default(cuid())
  organizationId String
  parentId       String?
  name           String
  slug           String
  description    String?
  icon           String?
  visibility     ContentVisibility @default(PUBLIC)
  position       Int               @default(0)
  isActive       Boolean           @default(true)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  deletedAt      DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  parent       KbCategory?  @relation("KbCategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children     KbCategory[] @relation("KbCategoryTree")
  articles     KbArticle[]

  @@unique([organizationId, slug])
  @@index([organizationId, parentId, position])
  @@index([organizationId, deletedAt])
  @@map("kb_categories")
}

model KbArticle {
  id              String            @id @default(cuid())
  organizationId  String
  categoryId      String?
  title           String
  slug            String
  summary         String?
  /// Markdown. Rendered without raw HTML so an article can never inject script.
  body            String
  status          ArticleStatus     @default(DRAFT)
  visibility      ContentVisibility @default(PUBLIC)
  authorId        String?
  publishedAt     DateTime?
  position        Int               @default(0)
  keywords        String[]          @default([])
  seoTitle        String?
  seoDescription  String?
  viewCount       Int               @default(0)
  helpfulCount    Int               @default(0)
  notHelpfulCount Int               @default(0)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  deletedAt       DateTime?

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  category     KbCategory?         @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  author       User?               @relation("AuthoredArticles", fields: [authorId], references: [id], onDelete: SetNull)
  feedback     KbArticleFeedback[]

  @@unique([organizationId, slug])
  @@index([organizationId, status, visibility])
  @@index([organizationId, categoryId, position])
  @@index([organizationId, deletedAt])
  @@map("kb_articles")
}

/// "Was this helpful?" — one vote per signed-in reader; anonymous votes are kept but
/// not deduplicated, which is why `userId` is nullable.
model KbArticleFeedback {
  id             String   @id @default(cuid())
  organizationId String
  articleId      String
  userId         String?
  isHelpful      Boolean
  comment        String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  article      KbArticle    @relation(fields: [articleId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([articleId, userId])
  @@index([organizationId, articleId])
  @@map("kb_article_feedback")
}

/// A public request form. `fields` holds the field definitions validated by the
/// shared Zod schema; a submission becomes a ticket, never a free-floating record.
model WebForm {
  id              String    @id @default(cuid())
  organizationId  String
  name            String
  slug            String
  description     String?
  departmentId    String?
  categoryId      String?
  priorityId      String?
  /// [{ "key": "order_id", "label": "Order number", "type": "TEXT", ... }]
  fields          Json      @default("[]")
  submitLabel     String    @default("Submit request")
  successMessage  String    @default("Thanks — we have received your request.")
  requireLogin    Boolean   @default(false)
  isActive        Boolean   @default(true)
  submissionCount Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  department   Department?     @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  category     TicketCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  priority     TicketPriority? @relation(fields: [priorityId], references: [id], onDelete: SetNull)

  @@unique([organizationId, slug])
  @@index([organizationId, isActive])
  @@index([organizationId, deletedAt])
  @@map("web_forms")
}

model CommunityCategory {
  id             String            @id @default(cuid())
  organizationId String
  name           String
  slug           String
  description    String?
  visibility     ContentVisibility @default(PUBLIC)
  position       Int               @default(0)
  isActive       Boolean           @default(true)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  deletedAt      DateTime?

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  topics       CommunityTopic[]

  @@unique([organizationId, slug])
  @@index([organizationId, position])
  @@index([organizationId, deletedAt])
  @@map("community_categories")
}

model CommunityTopic {
  id             String           @id @default(cuid())
  organizationId String
  categoryId     String
  authorId       String?
  title          String
  slug           String
  body           String
  type           TopicType        @default(QUESTION)
  status         TopicStatus      @default(OPEN)
  moderation     ModerationStatus @default(PUBLISHED)
  isPinned       Boolean          @default(false)
  isLocked       Boolean          @default(false)
  viewCount      Int              @default(0)
  replyCount     Int              @default(0)
  voteCount      Int              @default(0)
  /// Set when an agent turns the topic into a support ticket.
  ticketId       String?
  lastActivityAt DateTime         @default(now())
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  deletedAt      DateTime?

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  category     CommunityCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  author       User?             @relation("AuthoredTopics", fields: [authorId], references: [id], onDelete: SetNull)
  ticket       Ticket?           @relation(fields: [ticketId], references: [id], onDelete: SetNull)
  replies      CommunityReply[]
  votes        CommunityVote[]

  @@unique([organizationId, slug])
  @@index([organizationId, categoryId, lastActivityAt])
  @@index([organizationId, moderation])
  @@index([organizationId, deletedAt])
  @@map("community_topics")
}

model CommunityReply {
  id             String           @id @default(cuid())
  organizationId String
  topicId        String
  authorId       String?
  body           String
  moderation     ModerationStatus @default(PUBLISHED)
  /// Marked by the topic's author or an agent as the accepted answer.
  isAnswer       Boolean          @default(false)
  voteCount      Int              @default(0)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  deletedAt      DateTime?

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  topic        CommunityTopic  @relation(fields: [topicId], references: [id], onDelete: Cascade)
  author       User?           @relation("AuthoredReplies", fields: [authorId], references: [id], onDelete: SetNull)
  votes        CommunityVote[]

  @@index([organizationId, topicId, createdAt])
  @@index([organizationId, moderation])
  @@index([organizationId, deletedAt])
  @@map("community_replies")
}

/// One upvote per signed-in user per topic or reply; the counters on the parent rows
/// are maintained in the same transaction as the vote.
model CommunityVote {
  id             String   @id @default(cuid())
  organizationId String
  topicId        String?
  replyId        String?
  userId         String
  createdAt      DateTime @default(now())

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  topic        CommunityTopic? @relation(fields: [topicId], references: [id], onDelete: Cascade)
  reply        CommunityReply? @relation(fields: [replyId], references: [id], onDelete: Cascade)
  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([topicId, userId])
  @@unique([replyId, userId])
  @@index([organizationId, userId])
  @@map("community_votes")
}

// ---------------------------------------------------------------------------
// Phase 5 — omnichannel: channels, inbound events, live chat, outbound webhooks
// and API keys.
// ---------------------------------------------------------------------------

enum ChannelType {
  EMAIL
  CHAT
  WHATSAPP
  INSTAGRAM
  FACEBOOK
  TELEGRAM
  VOICE
}

enum ChannelEventStatus {
  RECEIVED
  PROCESSED
  /// Deliberately not turned into a message (auto-reply, loop, unknown recipient).
  IGNORED
  FAILED
}

enum ChatSessionStatus {
  QUEUED
  ACTIVE
  ENDED
}

enum DeliveryStatus {
  PENDING
  DELIVERED
  FAILED
}

/// One configured way in and out of the help desk. Secrets are encrypted at rest and
/// never leave the API; `config` holds only values that are safe to show an agent.
model Channel {
  id             String      @id @default(cuid())
  organizationId String
  type           ChannelType
  /// Adapter key inside the type, e.g. `mailgun`, `whatsapp_cloud`, `twilio`.
  provider       String
  name           String
  isActive       Boolean     @default(true)
  /// Address, phone number, page id or bot handle this channel answers on.
  identifier     String?
  /// Non-secret settings: signature mode, reply-to, greeting, working-hours notice.
  config         Json        @default("{}")
  /// AES-256-GCM blob holding the provider credentials.
  secrets        String?
  /// Shared secret for the inbound webhook URL, shown once when the channel is created.
  webhookSecret  String?
  /// Tickets raised by this channel start here.
  departmentId   String?
  priorityId     String?
  categoryId     String?
  lastInboundAt  DateTime?
  lastOutboundAt DateTime?
  lastErrorAt    DateTime?
  lastError      String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  deletedAt      DateTime?

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  department   Department?       @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  priority     TicketPriority?   @relation(fields: [priorityId], references: [id], onDelete: SetNull)
  category     TicketCategory?   @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  events       ChannelEvent[]
  identities   ChannelIdentity[]
  chatSessions ChatSession[]
  tickets      Ticket[]

  @@unique([organizationId, type, identifier])
  @@index([organizationId, type, isActive])
  @@index([organizationId, deletedAt])
  @@map("channels")
}

/// Who a contact is on a given channel: an email address, a phone number, a page-scoped
/// id or a chat id. One contact can hold several.
model ChannelIdentity {
  id             String      @id @default(cuid())
  organizationId String
  channelId      String?
  type           ChannelType
  /// Normalised external identity (lowercased address, E.164 number, provider id).
  externalId     String
  displayName    String?
  contactId      String
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  channel      Channel?     @relation(fields: [channelId], references: [id], onDelete: SetNull)
  contact      Contact      @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@unique([organizationId, type, externalId])
  @@index([organizationId, contactId])
  @@map("channel_identities")
}

/// Every inbound payload, stored before it is interpreted: the dedupe key, the audit
/// trail and the thing you re-run when a parser bug is fixed.
model ChannelEvent {
  id             String             @id @default(cuid())
  organizationId String
  channelId      String
  /// Provider's own id for the event; the unique index is what makes delivery idempotent.
  externalId     String
  status         ChannelEventStatus @default(RECEIVED)
  payload        Json
  error          String?
  ticketId       String?
  messageId      String?
  processedAt    DateTime?
  createdAt      DateTime           @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  channel      Channel      @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@unique([channelId, externalId])
  @@index([organizationId, status, createdAt])
  @@map("channel_events")
}

/// A live chat visit. The conversation itself is an ordinary ticket, so automation,
/// SLA and the agent workspace apply to chat exactly as they do to email.
model ChatSession {
  id             String            @id @default(cuid())
  organizationId String
  channelId      String?
  ticketId       String?
  contactId      String?
  /// Hash of the opaque token the widget holds; the token itself is never stored.
  tokenHash      String            @unique
  status         ChatSessionStatus @default(QUEUED)
  visitorName    String?
  visitorEmail   String?
  pageUrl        String?
  userAgent      String?
  ip             String?
  startedAt      DateTime          @default(now())
  lastSeenAt     DateTime          @default(now())
  endedAt        DateTime?
  rating         Int?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  channel      Channel?     @relation(fields: [channelId], references: [id], onDelete: SetNull)
  ticket       Ticket?      @relation(fields: [ticketId], references: [id], onDelete: SetNull)
  contact      Contact?     @relation(fields: [contactId], references: [id], onDelete: SetNull)

  @@index([organizationId, status, lastSeenAt])
  @@index([organizationId, ticketId])
  @@map("chat_sessions")
}

/// An HTTP endpoint the organization wants told about events, with its own signing key.
model WebhookEndpoint {
  id             String    @id @default(cuid())
  organizationId String
  name           String
  url            String
  /// Signing key for the `X-Digisoft-Signature` header; shown once at creation.
  secret         String
  /// Event names this endpoint wants; empty means every event.
  events         String[]  @default([])
  isActive       Boolean   @default(true)
  lastSuccessAt  DateTime?
  lastFailureAt  DateTime?
  failureCount   Int       @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  deliveries   WebhookDelivery[]

  @@index([organizationId, isActive])
  @@index([organizationId, deletedAt])
  @@map("webhook_endpoints")
}

model WebhookDelivery {
  id             String         @id @default(cuid())
  organizationId String
  endpointId     String
  event          String
  payload        Json
  status         DeliveryStatus @default(PENDING)
  attempts       Int            @default(0)
  responseStatus Int?
  responseBody   String?
  error          String?
  deliveredAt    DateTime?
  createdAt      DateTime       @default(now())

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  endpoint     WebhookEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)

  @@index([organizationId, endpointId, createdAt])
  @@index([organizationId, status])
  @@map("webhook_deliveries")
}

/// Machine access. The key is shown once; only its hash is stored, and it carries a
/// role so an integration is authorised through exactly the same permission checks.
/// Machine access. Every key is backed by its own service user, so a call from an
/// integration is authorised, audited and attributed exactly like one from a person.
model ApiKey {
  id             String    @id @default(cuid())
  organizationId String
  name           String
  /// The service user this key acts as.
  userId         String    @unique
  /// Visible prefix (`dsk_live_ab12…`) so a key can be recognised without revealing it.
  prefix         String
  keyHash        String    @unique
  roleId         String
  createdById    String?
  lastUsedAt     DateTime?
  expiresAt      DateTime?
  revokedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role         Role         @relation(fields: [roleId], references: [id], onDelete: Cascade)
  user         User         @relation("ApiKeyIdentity", fields: [userId], references: [id], onDelete: Cascade)
  createdBy    User?        @relation("ApiKeyCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([organizationId, revokedAt])
  @@map("api_keys")
}

// ---------------------------------------------------------------------------
// Phase 6 — AI assistance: provider settings, generated insights and usage.
// ---------------------------------------------------------------------------

enum AiProviderKind {
  /// Claude, through the official Anthropic SDK.
  ANTHROPIC
  /// Deterministic on-device analysis. No credentials, no network, no cost.
  HEURISTIC
}

enum AiInsightType {
  SUMMARY
  SENTIMENT
  INTENT
  SUGGESTED_REPLY
  KB_SUGGESTIONS
}

enum AiInsightStatus {
  PENDING
  READY
  FAILED
}

/// One AI configuration per organization. The API key is encrypted with the same
/// key as channel credentials and never leaves the API.
model AiSettings {
  id                    String         @id @default(cuid())
  organizationId        String         @unique
  provider              AiProviderKind @default(HEURISTIC)
  /// Provider model id, e.g. `claude-opus-5`.
  model                 String         @default("claude-opus-5")
  /// AES-256-GCM blob holding the provider credentials.
  secrets               String?
  isEnabled             Boolean        @default(false)
  /// Individually switchable so an organization can adopt one feature at a time.
  summaryEnabled        Boolean        @default(true)
  sentimentEnabled      Boolean        @default(true)
  intentEnabled         Boolean        @default(true)
  suggestedReplyEnabled Boolean        @default(true)
  /// Generate summary, sentiment and intent as tickets arrive, not only on demand.
  autoAnalyse           Boolean        @default(true)
  /// Hard ceiling on spend per calendar month; 0 means no limit.
  monthlyTokenBudget    Int            @default(0)
  /// Extra instructions folded into every prompt (tone, product names, languages).
  promptGuidance        String?
  lastCheckedAt         DateTime?
  lastError             String?
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("ai_settings")
}

/// A generated insight. Kept per ticket and type so the newest supersedes the last
/// without losing the trail, and so usage can be attributed and capped.
model AiInsight {
  id             String          @id @default(cuid())
  organizationId String
  ticketId       String
  type           AiInsightType
  status         AiInsightStatus @default(READY)
  /// Shape depends on the type: { text }, { sentiment, score }, { categoryId, … }.
  content        Json
  provider       AiProviderKind
  model          String
  inputTokens    Int             @default(0)
  outputTokens   Int             @default(0)
  /// Estimated cost in ten-thousandths of a cent, so sub-cent calls stay exact.
  costMicros     Int             @default(0)
  latencyMs      Int             @default(0)
  error          String?
  /// Null when the worker generated it automatically.
  requestedById  String?
  createdAt      DateTime        @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  ticket       Ticket       @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  requestedBy  User?        @relation(fields: [requestedById], references: [id], onDelete: SetNull)

  @@index([organizationId, ticketId, type, createdAt])
  @@index([organizationId, createdAt])
  @@map("ai_insights")
}

// ---------------------------------------------------------------------------
// Phase 7 — analytics, reporting and CSAT
// ---------------------------------------------------------------------------

enum CsatStatus {
  PENDING
  ANSWERED
  EXPIRED
}

enum ReportKind {
  TICKETS
  AGENTS
  SLA
  CSAT
}

enum ExportStatus {
  QUEUED
  READY
  FAILED
}

/// When and how satisfaction surveys go out. One row per organization.
model CsatSettings {
  id             String   @id @default(cuid())
  organizationId String   @unique
  isEnabled      Boolean  @default(false)
  /// Minutes to wait after a ticket is resolved before the survey is sent.
  delayMinutes   Int      @default(60)
  /// Days a survey link stays usable.
  expiryDays     Int      @default(14)
  subject        String   @default("How did we do?")
  introText      String   @default("Please rate the support you received. It takes a few seconds.")
  thankYouText   String   @default("Thank you — your feedback goes straight to the team that helped you.")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("csat_settings")
}

/// One survey per resolution. The row is written when the survey is sent, so the
/// response rate is a fact rather than an estimate.
model CsatResponse {
  id             String     @id @default(cuid())
  organizationId String
  ticketId       String     @unique
  contactId      String?
  /// The agent credited with the resolution, snapshotted so later reassignment
  /// cannot rewrite history.
  agentId        String?
  departmentId   String?
  status         CsatStatus @default(PENDING)
  /// SHA-256 of the link token; the token itself is only ever in the email.
  tokenHash      String     @unique
  /// 1–5. Null until the customer answers.
  rating         Int?
  comment        String?
  sentAt         DateTime   @default(now())
  respondedAt    DateTime?
  expiresAt      DateTime

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  ticket       Ticket       @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  contact      Contact?     @relation(fields: [contactId], references: [id], onDelete: SetNull)
  agent        User?        @relation(fields: [agentId], references: [id], onDelete: SetNull)
  department   Department?  @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  @@unique([organizationId, ticketId])
  @@index([organizationId, status, respondedAt])
  @@index([organizationId, agentId, respondedAt])
  @@map("csat_responses")
}

/// A saved set of report filters, so a team looks at the same numbers every week.
model ReportDefinition {
  id             String     @id @default(cuid())
  organizationId String
  name           String
  kind           ReportKind
  /// Range, department, agent, priority and grouping — validated by the same Zod
  /// schema the query endpoints use.
  filters        Json
  description    String?
  createdById    String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User?        @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([organizationId, name])
  @@index([organizationId, kind])
  @@map("report_definitions")
}

/// A CSV the worker writes to object storage; downloads are re-authorised and signed.
model ReportExport {
  id             String       @id @default(cuid())
  organizationId String
  kind           ReportKind
  filters        Json
  status         ExportStatus @default(QUEUED)
  storageKey     String?
  fileName       String?
  rowCount       Int          @default(0)
  sizeBytes      Int          @default(0)
  error          String?
  requestedById  String?
  createdAt      DateTime     @default(now())
  completedAt    DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  requestedBy  User?        @relation(fields: [requestedById], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@map("report_exports")
}

/// Daily ticket rollup, one row per department per day (`departmentId` null is the
/// department-less queue, not a total — organization figures are the sum of the day's
/// rows), so a dashboard reads days instead of scanning the ticket table.
model TicketDailyMetric {
  id             String   @id @default(cuid())
  organizationId String
  /// Midnight UTC of the day being summarised.
  day            DateTime
  departmentId   String?
  created        Int      @default(0)
  resolved       Int      @default(0)
  closed         Int      @default(0)
  reopened       Int      @default(0)
  firstResponses Int      @default(0)
  slaFirstMet    Int      @default(0)
  slaFirstBreach Int      @default(0)
  slaResMet      Int      @default(0)
  slaResBreach   Int      @default(0)
  /// Sums, not averages: two days can be added without weighting them by hand.
  firstResponseMinutes Int @default(0)
  resolutionMinutes    Int @default(0)
  resolutionSamples    Int @default(0)
  computedAt     DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  department   Department?  @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  @@unique([organizationId, day, departmentId])
  @@index([organizationId, day])
  @@map("ticket_daily_metrics")
}

/// Daily agent rollup: what each agent actually did that day.
model AgentDailyMetric {
  id             String   @id @default(cuid())
  organizationId String
  day            DateTime
  agentId        String
  assigned       Int      @default(0)
  resolved       Int      @default(0)
  publicReplies  Int      @default(0)
  firstResponses Int      @default(0)
  firstResponseMinutes Int @default(0)
  resolutionMinutes    Int @default(0)
  resolutionSamples    Int @default(0)
  csatResponses  Int      @default(0)
  csatRatingSum  Int      @default(0)
  computedAt     DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  agent        User         @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@unique([organizationId, day, agentId])
  @@index([organizationId, day])
  @@map("agent_daily_metrics")
}
