// Digisoft360 Help Desk — Phase 1 (Foundation) schema.
// Every tenant-owned model carries `organizationId`; isolation is enforced by the
// Prisma client extension in src/prisma/tenant.extension.ts, not by callers.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserType {
  AGENT
  CUSTOMER
}

enum ContactStatus {
  ACTIVE
  INACTIVE
  BLOCKED
}

enum TokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
  INVITE
}

enum ActorType {
  USER
  SYSTEM
  AUTOMATION
}

model Organization {
  id             String    @id @default(cuid())
  name           String
  slug           String    @unique
  logoUrl        String?
  domain         String?
  timezone       String    @default("UTC")
  locale         String    @default("en")
  currency       String    @default("USD")
  settings       Json      @default("{}")
  /// Monotonic per-organization ticket counter, bumped inside the creation transaction.
  ticketSequence Int       @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  users            User[]
  roles            Role[]
  departments      Department[]
  teams            Team[]
  contacts         Contact[]
  accounts         Account[]
  businessHours    BusinessHours[]
  holidays         Holiday[]
  auditLogs        AuditLog[]
  refreshTokens    RefreshToken[]
  notifications    Notification[]
  ticketStatuses   TicketStatus[]
  ticketPriorities TicketPriority[]
  ticketCategories TicketCategory[]
  tags             Tag[]
  tickets          Ticket[]
  ticketMessages   TicketMessage[]
  attachments      Attachment[]
  ticketLinks      TicketLink[]
  activities       Activity[]
  assignmentRules  AssignmentRule[]
  automationRules  AutomationRule[]
  automationRuns   AutomationRun[]
  slaPolicies      SlaPolicy[]
  blueprints       Blueprint[]

  @@index([deletedAt])
  @@map("organizations")
}

model BusinessHours {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  timezone       String   @default("UTC")
  isDefault      Boolean  @default(false)
  /// [{ "day": 1, "start": "09:00", "end": "18:00" }]
  weeklySchedule Json
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  holidays     Holiday[]
  slaPolicies  SlaPolicy[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("business_hours")
}

model Holiday {
  id              String   @id @default(cuid())
  organizationId  String
  businessHoursId String
  name            String
  date            DateTime @db.Date
  createdAt       DateTime @default(now())

  organization  Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  businessHours BusinessHours @relation(fields: [businessHoursId], references: [id], onDelete: Cascade)

  @@unique([businessHoursId, date])
  @@index([organizationId, date])
  @@map("holidays")
}

model User {
  id              String    @id @default(cuid())
  organizationId  String
  email           String
  passwordHash    String?
  firstName       String
  lastName        String
  avatarUrl       String?
  phone           String?
  type            UserType  @default(AGENT)
  contactId       String?   @unique
  isActive        Boolean   @default(true)
  emailVerifiedAt DateTime?
  lastLoginAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  organization       Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contact            Contact?            @relation(fields: [contactId], references: [id], onDelete: SetNull)
  roles              UserRole[]
  departments        UserDepartment[]
  teams              TeamMember[]
  refreshTokens      RefreshToken[]
  tokens             VerificationToken[]
  notifications      Notification[]
  assignedTickets    Ticket[]            @relation("AssignedTickets")
  createdTickets     Ticket[]            @relation("CreatedTickets")
  ticketMessages     TicketMessage[]
  uploads            Attachment[]
  following          TicketFollower[]
  assignedActivities Activity[]          @relation("AssignedActivities")
  createdActivities  Activity[]          @relation("CreatedActivities")
  assignmentRules    AssignmentRule[]

  @@unique([organizationId, email])
  @@index([organizationId, isActive, deletedAt])
  @@index([organizationId, type])
  @@map("users")
}

model Role {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  systemKey      String?
  description    String?
  isSystem       Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  permissions  RolePermission[]
  users        UserRole[]

  @@unique([organizationId, name])
  @@unique([organizationId, systemKey])
  @@index([organizationId])
  @@map("roles")
}

/// Global catalogue — intentionally NOT tenant scoped.
model Permission {
  id          String  @id @default(cuid())
  key         String  @unique
  resource    String
  action      String
  description String?

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model UserRole {
  userId String
  roleId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

model Department {
  id             String    @id @default(cuid())
  organizationId String
  name           String
  description    String?
  email          String?
  isDefault      Boolean   @default(false)
  parentId       String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  parent          Department?      @relation("DepartmentHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children        Department[]     @relation("DepartmentHierarchy")
  members         UserDepartment[]
  teams           Team[]
  tickets         Ticket[]
  assignmentRules AssignmentRule[]

  @@unique([organizationId, name])
  @@index([organizationId, deletedAt])
  @@map("departments")
}

model UserDepartment {
  userId       String
  departmentId String

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  department Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  @@id([userId, departmentId])
  @@index([departmentId])
  @@map("user_departments")
}

model Team {
  id             String    @id @default(cuid())
  organizationId String
  departmentId   String?
  name           String
  description    String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  department      Department?      @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  members         TeamMember[]
  assignmentRules AssignmentRule[]

  @@unique([organizationId, name])
  @@index([organizationId, departmentId])
  @@map("teams")
}

model TeamMember {
  teamId String
  userId String

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([teamId, userId])
  @@index([userId])
  @@map("team_members")
}

model Account {
  id             String    @id @default(cuid())
  organizationId String
  name           String
  website        String?
  industry       String?
  phone          String?
  email          String?
  addressLine1   String?
  addressLine2   String?
  city           String?
  state          String?
  postalCode     String?
  country        String?
  description    String?
  customFields   Json?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contacts     Contact[]
  tickets      Ticket[]
  activities   Activity[]

  @@index([organizationId, name])
  @@index([organizationId, deletedAt])
  @@map("accounts")
}

model Contact {
  id             String        @id @default(cuid())
  organizationId String
  accountId      String?
  firstName      String
  lastName       String?
  email          String?
  phone          String?
  mobile         String?
  jobTitle       String?
  avatarUrl      String?
  status         ContactStatus @default(ACTIVE)
  isVip          Boolean       @default(false)
  customFields   Json?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  deletedAt      DateTime?

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  account      Account?        @relation(fields: [accountId], references: [id], onDelete: SetNull)
  portalUser   User?
  tickets      Ticket[]
  messages     TicketMessage[]
  activities   Activity[]

  @@unique([organizationId, email])
  @@index([organizationId, accountId])
  @@index([organizationId, deletedAt])
  @@index([organizationId, lastName, firstName])
  @@map("contacts")
}

model RefreshToken {
  id             String    @id @default(cuid())
  organizationId String
  userId         String
  tokenHash      String    @unique
  familyId       String
  userAgent      String?
  ip             String?
  expiresAt      DateTime
  revokedAt      DateTime?
  createdAt      DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, familyId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model VerificationToken {
  id        String    @id @default(cuid())
  userId    String
  type      TokenType
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@map("verification_tokens")
}

model Notification {
  id             String    @id @default(cuid())
  organizationId String
  userId         String
  type           String
  title          String
  body           String?
  link           String?
  data           Json?
  readAt         DateTime?
  createdAt      DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([organizationId, userId, readAt, createdAt])
  @@map("notifications")
}

model AuditLog {
  id             String    @id @default(cuid())
  organizationId String
  actorId        String?
  actorType      ActorType @default(USER)
  action         String
  entity         String
  entityId       String
  oldValue       Json?
  newValue       Json?
  ip             String?
  createdAt      DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, entity, entityId, createdAt])
  @@index([organizationId, createdAt])
  @@map("audit_logs")
}

// ---------------------------------------------------------------------------
// Phase 2 — Core helpdesk
// ---------------------------------------------------------------------------

enum TicketSource {
  AGENT
  PORTAL
  WEB_FORM
  EMAIL
  CHAT
  PHONE
  API
  WHATSAPP
  INSTAGRAM
  FACEBOOK
  TELEGRAM
}

enum MessageType {
  /// Visible to the customer.
  PUBLIC_REPLY
  /// Agents only. Never serialised to a customer-facing response.
  INTERNAL_COMMENT
  /// Written by the system, e.g. a merge notice.
  SYSTEM_NOTE
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum TicketLinkType {
  RELATED
  DUPLICATE
  BLOCKS
}

/// Status values are rows, not an enum: organizations may add their own, and no code
/// branches on the name — behaviour comes from the flags.
model TicketStatus {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  systemKey      String?
  color          String   @default("#64748b")
  position       Int      @default(0)
  isDefault      Boolean  @default(false)
  /// Stops the SLA resolution clock and counts as solved in reporting.
  isResolved     Boolean  @default(false)
  /// Terminal: the ticket is archived from active queues.
  isClosed       Boolean  @default(false)
  /// Stops the SLA clock while the ticket waits on someone else (on hold, pending).
  pausesSla      Boolean  @default(false)
  isSystem       Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization    Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  tickets         Ticket[]
  transitionsFrom BlueprintTransition[] @relation("TransitionFrom")
  transitionsTo   BlueprintTransition[] @relation("TransitionTo")

  @@unique([organizationId, name])
  @@unique([organizationId, systemKey])
  @@index([organizationId, position])
  @@map("ticket_statuses")
}

model TicketPriority {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  systemKey      String?
  color          String   @default("#64748b")
  /// Higher wins when automation or assignment rules compare two priorities.
  weight         Int      @default(0)
  position       Int      @default(0)
  isDefault      Boolean  @default(false)
  isSystem       Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  tickets      Ticket[]
  slaTargets   SlaTarget[]

  @@unique([organizationId, name])
  @@unique([organizationId, systemKey])
  @@index([organizationId, position])
  @@map("ticket_priorities")
}

model TicketCategory {
  id             String    @id @default(cuid())
  organizationId String
  name           String
  description    String?
  parentId       String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  parent       TicketCategory?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children     TicketCategory[] @relation("CategoryHierarchy")
  tickets      Ticket[]

  @@unique([organizationId, name])
  @@index([organizationId, deletedAt])
  @@map("ticket_categories")
}

model Tag {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  color          String   @default("#64748b")
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  tickets      TicketTag[]

  @@unique([organizationId, name])
  @@map("tags")
}

model Ticket {
  id                        String       @id @default(cuid())
  organizationId            String
  /// Sequential per organization, allocated inside the creation transaction.
  ticketNumber              Int
  subject                   String
  description               String
  source                    TicketSource @default(AGENT)
  contactId                 String?
  accountId                 String?
  departmentId              String?
  assignedAgentId           String?
  categoryId                String?
  statusId                  String
  priorityId                String
  createdById               String?
  /// Mirrors resolutionDueAt so queue sorting needs one column.
  dueAt                     DateTime?
  slaPolicyId               String?
  firstResponseDueAt        DateTime?
  resolutionDueAt           DateTime?
  firstResponseWarnedAt     DateTime?
  resolutionWarnedAt        DateTime?
  firstResponseBreachedAt   DateTime?
  resolutionBreachedAt      DateTime?
  /// Set while the ticket sits in a status that pauses the SLA clock.
  slaPausedAt               DateTime?
  /// Business minutes still available when the clock was paused.
  firstResponseRemainingMin Int?
  resolutionRemainingMin    Int?
  firstResponseAt           DateTime?
  resolvedAt                DateTime?
  closedAt                  DateTime?
  resolutionNote            String?
  mergedIntoTicketId        String?
  customFields              Json?
  createdAt                 DateTime     @default(now())
  updatedAt                 DateTime     @updatedAt
  deletedAt                 DateTime?

  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contact        Contact?        @relation(fields: [contactId], references: [id], onDelete: SetNull)
  account        Account?        @relation(fields: [accountId], references: [id], onDelete: SetNull)
  department     Department?     @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  assignedAgent  User?           @relation("AssignedTickets", fields: [assignedAgentId], references: [id], onDelete: SetNull)
  createdBy      User?           @relation("CreatedTickets", fields: [createdById], references: [id], onDelete: SetNull)
  category       TicketCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  status         TicketStatus    @relation(fields: [statusId], references: [id])
  priority       TicketPriority  @relation(fields: [priorityId], references: [id])
  mergedInto     Ticket?         @relation("TicketMerges", fields: [mergedIntoTicketId], references: [id], onDelete: SetNull)
  mergedTickets  Ticket[]        @relation("TicketMerges")
  slaPolicy      SlaPolicy?      @relation(fields: [slaPolicyId], references: [id], onDelete: SetNull)
  activities     Activity[]
  automationRuns AutomationRun[]

  messages    TicketMessage[]
  attachments Attachment[]
  tags        TicketTag[]
  followers   TicketFollower[]
  links       TicketLink[]     @relation("TicketLinkSource")
  linkedFrom  TicketLink[]     @relation("TicketLinkTarget")

  @@unique([organizationId, ticketNumber])
  @@index([organizationId, statusId, createdAt])
  @@index([organizationId, priorityId])
  @@index([organizationId, assignedAgentId, statusId])
  @@index([organizationId, departmentId, statusId])
  @@index([organizationId, contactId])
  @@index([organizationId, accountId])
  @@index([organizationId, createdAt])
  @@index([organizationId, dueAt])
  @@index([organizationId, firstResponseDueAt])
  @@index([organizationId, resolutionDueAt])
  @@index([organizationId, deletedAt])
  @@map("tickets")
}

model TicketTag {
  ticketId String
  tagId    String

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([ticketId, tagId])
  @@index([tagId])
  @@map("ticket_tags")
}

/// One row per reply or comment. A conversation is never a single text column.
model TicketMessage {
  id                String           @id @default(cuid())
  organizationId    String
  ticketId          String
  type              MessageType      @default(PUBLIC_REPLY)
  direction         MessageDirection @default(OUTBOUND)
  /// Exactly one author is set: an agent, a contact, or neither for system notes.
  authorUserId      String?
  authorContactId   String?
  bodyText          String
  bodyHtml          String?
  channel           TicketSource     @default(AGENT)
  /// Provider message id, used for email threading from Phase 5.
  externalMessageId String?
  inReplyToId       String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  deletedAt         DateTime?

  organization  Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  ticket        Ticket          @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorUser    User?           @relation(fields: [authorUserId], references: [id], onDelete: SetNull)
  authorContact Contact?        @relation(fields: [authorContactId], references: [id], onDelete: SetNull)
  inReplyTo     TicketMessage?  @relation("MessageThread", fields: [inReplyToId], references: [id], onDelete: SetNull)
  replies       TicketMessage[] @relation("MessageThread")
  attachments   Attachment[]

  @@unique([organizationId, externalMessageId])
  @@index([organizationId, ticketId, createdAt])
  @@index([organizationId, type])
  @@map("ticket_messages")
}

/// Only metadata lives in PostgreSQL; bytes go to object storage.
model Attachment {
  id             String   @id @default(cuid())
  organizationId String
  ticketId       String?
  messageId      String?
  fileName       String
  fileSize       Int
  mimeType       String
  storageKey     String   @unique
  uploadedById   String?
  createdAt      DateTime @default(now())

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  ticket       Ticket?        @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  message      TicketMessage? @relation(fields: [messageId], references: [id], onDelete: Cascade)
  uploadedBy   User?          @relation(fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([organizationId, ticketId])
  @@index([organizationId, messageId])
  @@map("attachments")
}

model TicketFollower {
  ticketId  String
  userId    String
  createdAt DateTime @default(now())

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([ticketId, userId])
  @@index([userId])
  @@map("ticket_followers")
}

model TicketLink {
  id             String         @id @default(cuid())
  organizationId String
  ticketId       String
  linkedTicketId String
  type           TicketLinkType @default(RELATED)
  createdAt      DateTime       @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  ticket       Ticket       @relation("TicketLinkSource", fields: [ticketId], references: [id], onDelete: Cascade)
  linkedTicket Ticket       @relation("TicketLinkTarget", fields: [linkedTicketId], references: [id], onDelete: Cascade)

  @@unique([ticketId, linkedTicketId])
  @@index([organizationId, linkedTicketId])
  @@map("ticket_links")
}

// ---------------------------------------------------------------------------
// Phase 3 — Support operations
// ---------------------------------------------------------------------------

enum ActivityType {
  TASK
  CALL
  EVENT
}

enum ActivityStatus {
  OPEN
  COMPLETED
  CANCELLED
}

enum CallDirection {
  INBOUND
  OUTBOUND
}

enum AssignmentStrategy {
  /// Always the configured agent.
  SPECIFIC_AGENT
  /// Route to a department only; an agent picks it up.
  DEPARTMENT
  /// Rotate through the department's (or team's) active agents.
  ROUND_ROBIN
  /// The active agent with the fewest open tickets.
  LEAST_LOADED
}

enum AutomationTrigger {
  TICKET_CREATED
  TICKET_UPDATED
  TICKET_ASSIGNED
  STATUS_CHANGED
  PRIORITY_CHANGED
  CUSTOMER_REPLIED
  AGENT_REPLIED
  SLA_WARNING
  SLA_BREACHED
}

/// Tasks, calls and events — only where they relate to support work.
model Activity {
  id                  String         @id @default(cuid())
  organizationId      String
  type                ActivityType
  status              ActivityStatus @default(OPEN)
  subject             String
  description         String?
  dueAt               DateTime?
  startAt             DateTime?
  endAt               DateTime?
  completedAt         DateTime?
  callDirection       CallDirection?
  callDurationSeconds Int?
  callOutcome         String?
  location            String?
  ticketId            String?
  contactId           String?
  accountId           String?
  assignedToId        String?
  createdById         String?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  deletedAt           DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  ticket       Ticket?      @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  contact      Contact?     @relation(fields: [contactId], references: [id], onDelete: SetNull)
  account      Account?     @relation(fields: [accountId], references: [id], onDelete: SetNull)
  assignedTo   User?        @relation("AssignedActivities", fields: [assignedToId], references: [id], onDelete: SetNull)
  createdBy    User?        @relation("CreatedActivities", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([organizationId, type, status, dueAt])
  @@index([organizationId, ticketId])
  @@index([organizationId, contactId])
  @@index([organizationId, accountId])
  @@index([organizationId, assignedToId, status])
  @@index([organizationId, deletedAt])
  @@map("activities")
}

/// Ordered routing rules evaluated when a ticket is created; the first match wins.
model AssignmentRule {
  id                 String             @id @default(cuid())
  organizationId     String
  name               String
  isActive           Boolean            @default(true)
  position           Int                @default(0)
  /// Condition tree in the shared rule DSL.
  conditions         Json
  strategy           AssignmentStrategy
  departmentId       String?
  teamId             String?
  agentId            String?
  /// Round-robin cursor: the agent who received the previous ticket.
  lastAssignedUserId String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  department   Department?  @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  team         Team?        @relation(fields: [teamId], references: [id], onDelete: SetNull)
  agent        User?        @relation(fields: [agentId], references: [id], onDelete: SetNull)

  @@index([organizationId, isActive, position])
  @@map("assignment_rules")
}

/// Trigger + conditions + actions. Escalations are rules on the SLA triggers.
model AutomationRule {
  id             String            @id @default(cuid())
  organizationId String
  name           String
  description    String?
  isActive       Boolean           @default(true)
  position       Int               @default(0)
  trigger        AutomationTrigger
  conditions     Json
  actions        Json
  runCount       Int               @default(0)
  lastRunAt      DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  runs         AutomationRun[]

  @@index([organizationId, trigger, isActive, position])
  @@map("automation_rules")
}

/// One row per rule evaluation, so an administrator can see why a rule did or did not fire.
model AutomationRun {
  id             String            @id @default(cuid())
  organizationId String
  ruleId         String
  ticketId       String?
  trigger        AutomationTrigger
  matched        Boolean
  actionsApplied Json?
  error          String?
  createdAt      DateTime          @default(now())

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  rule         AutomationRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  ticket       Ticket?        @relation(fields: [ticketId], references: [id], onDelete: SetNull)

  @@index([organizationId, ruleId, createdAt])
  @@index([organizationId, ticketId, createdAt])
  @@map("automation_runs")
}

model SlaPolicy {
  id                   String   @id @default(cuid())
  organizationId       String
  name                 String
  description          String?
  isActive             Boolean  @default(true)
  isDefault            Boolean  @default(false)
  position             Int      @default(0)
  /// Which tickets the policy applies to; the first matching active policy wins.
  conditions           Json
  businessHoursId      String?
  /// Fire the SLA_WARNING trigger this many minutes before a target is due.
  warningMinutesBefore Int      @default(30)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  organization  Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  businessHours BusinessHours? @relation(fields: [businessHoursId], references: [id], onDelete: SetNull)
  targets       SlaTarget[]
  tickets       Ticket[]

  @@unique([organizationId, name])
  @@index([organizationId, isActive, position])
  @@map("sla_policies")
}

/// Per-priority targets. A row with no priority is the fallback for the policy.
model SlaTarget {
  id                   String  @id @default(cuid())
  slaPolicyId          String
  priorityId           String?
  firstResponseMinutes Int
  resolutionMinutes    Int
  /// Count only business hours (from the policy's calendar) or the wall clock.
  useBusinessHours     Boolean @default(true)

  policy   SlaPolicy       @relation(fields: [slaPolicyId], references: [id], onDelete: Cascade)
  priority TicketPriority? @relation(fields: [priorityId], references: [id], onDelete: Cascade)

  @@unique([slaPolicyId, priorityId])
  @@map("sla_targets")
}

/// A configurable state machine applied to matching tickets.
model Blueprint {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  description    String?
  isActive       Boolean  @default(true)
  position       Int      @default(0)
  /// Which tickets the blueprint governs; the first matching active blueprint wins.
  conditions     Json
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  transitions  BlueprintTransition[]

  @@unique([organizationId, name])
  @@index([organizationId, isActive, position])
  @@map("blueprints")
}

model BlueprintTransition {
  id             String   @id @default(cuid())
  blueprintId    String
  name           String
  /// Null means the transition is allowed from any status.
  fromStatusId   String?
  toStatusId     String
  /// Ticket fields that must be set before the transition is allowed.
  requiredFields Json     @default("[]")
  /// Role ids permitted to make the transition; empty means anyone with ticket.update.
  allowedRoleIds Json     @default("[]")
  conditions     Json     @default("{}")
  /// Actions applied after a successful transition.
  actions        Json     @default("[]")
  position       Int      @default(0)
  createdAt      DateTime @default(now())

  blueprint  Blueprint     @relation(fields: [blueprintId], references: [id], onDelete: Cascade)
  fromStatus TicketStatus? @relation("TransitionFrom", fields: [fromStatusId], references: [id], onDelete: Cascade)
  toStatus   TicketStatus  @relation("TransitionTo", fields: [toStatusId], references: [id], onDelete: Cascade)

  @@index([blueprintId, fromStatusId])
  @@map("blueprint_transitions")
}
