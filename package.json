{
  "name": "digisoft360-helpdesk",
  "private": true,
  "version": "0.1.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "dev:api": "pnpm --filter @digisoft/api dev",
    "dev:web": "pnpm --filter @digisoft/web dev",
    "dev:worker": "pnpm --filter @digisoft/worker dev",
    "db:migrate": "pnpm --filter @digisoft/db migrate",
    "db:seed": "pnpm --filter @digisoft/db seed",
    "db:generate": "pnpm --filter @digisoft/db generate",
    "db:deploy": "pnpm --filter @digisoft/db migrate:deploy"
  },
  "devDependencies": {
    "prettier": "^3.4.2",
    "typescript": "^5.7.3"
  }
}
